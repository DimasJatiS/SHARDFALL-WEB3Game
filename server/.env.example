# Operator wallet (testnet only). Must be the `operator` set in MatchEscrow. NEVER commit .env.
OPERATOR_PRIVATE_KEY=
ESCROW_ADDRESS=
# Use a different RPC than the client to avoid rate limits
RPC_URL=https://rpc.ankr.com/monad_testnet
RPC_URL_FALLBACK=https://testnet-rpc.monad.xyz
PORT=2567
# Must match the client's VITE_DEMO
DEMO=false
LOBBY_SECONDS=120
