# Copy to .env (or .env.local) and fill in after deploying contracts / starting the server.

# Colyseus game server (leave empty to run practice mode only)
VITE_SERVER_URL=ws://localhost:2567

# Deployed contracts on Monad Testnet (chain 10143)
VITE_ESCROW_ADDRESS=0x8b8603b9e6112b0af377ec1c836c0d43290197a1
VITE_SKIN_SHOP_ADDRESS=0xc34d3cd946adac1d4bf1367f2d030cf232503f1f

# Client RPC (use a different one than the server to avoid rate limits)
VITE_RPC_URL=https://testnet-rpc.monad.xyz

# Faster zones + lower quotas so a pitch demo ends in ~90 s
VITE_DEMO=false
